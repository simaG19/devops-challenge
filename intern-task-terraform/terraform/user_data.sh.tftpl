#!/bin/bash
set -Eeuo pipefail

exec > >(tee /var/log/intern-task-app-bootstrap.log | logger -t intern-task-app-bootstrap -s 2>/dev/console) 2>&1

# Install Docker, the host firewall, and sudo.
dnf update -y
dnf install -y docker firewalld sudo

systemctl enable --now docker

# Create a non-root user with passwordless sudo.
if ! id devops >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash devops
fi

printf '%s\n' 'devops ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/devops
chmod 0440 /etc/sudoers.d/devops
visudo -cf /etc/sudoers.d/devops

# Prepare the build context for the real Task 1 application.
install -d -m 0755 /opt/intern-task-app/app

printf '%s' '${dockerfile_b64}' | base64 --decode > /opt/intern-task-app/Dockerfile
printf '%s' '${app_py_b64}' | base64 --decode > /opt/intern-task-app/app/app.py

# Build the same application image used in Task 1.
docker build -t intern-task-app:local /opt/intern-task-app

# Configure the host firewall. SSH is restricted to the supplied CIDR.
# Application traffic is allowed on the app's actual listening port.
systemctl enable --now firewalld

firewall-cmd --permanent --zone=public --set-target=DROP
firewall-cmd --permanent --zone=public --remove-service=ssh || true
firewall-cmd --permanent --zone=public --remove-service=dhcpv6-client || true
firewall-cmd --permanent --zone=public --add-port=${app_port}/tcp
firewall-cmd --permanent --zone=public --add-rich-rule='rule family="ipv4" source address="${ssh_cidr}" port port="22" protocol="tcp" accept'
firewall-cmd --reload

# Run the container under systemd so it restarts after failures and reboots.
cat > /etc/systemd/system/intern-task-app.service <<'UNIT'
[Unit]
Description=Intern Task App container
Wants=network-online.target
After=network-online.target docker.service firewalld.service
Requires=docker.service firewalld.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStart=/usr/bin/docker run --rm --name intern-task-app --network host intern-task-app:local
ExecStop=/usr/bin/docker stop --time 10 intern-task-app
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now intern-task-app.service
